# --- Database ---
# PostgreSQL connection string. If omitted, Kick Log uses an embedded PGlite
# (real Postgres compiled to WASM) stored in ./.data/pglite — handy for local dev only.
DATABASE_URL=postgres://kicklog:kicklog@localhost:5432/kicklog

# --- AI (server-side only; never prefix with NEXT_PUBLIC_) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# "mock" uses a deterministic regex parser instead of Claude (dev/e2e only, never production)
AI_MODE=live

# --- Auth ---
# Optional: auto-create the first Owner on startup. Otherwise the /login page offers first-run setup.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=Owner

# --- Storage (product images and bills) ---
# local (default, ./uploads) or s3 (any S3-compatible object store)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Public showroom ---
# Digits only, with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SHOP_NAME=Kick Log
